# Public Privy application ID from the Privy dashboard.
# The app remains usable in privacy-first guest mode when this is empty.
VITE_PRIVY_APP_ID=

# Server-side family account configuration. PRIVY_APP_ID is the same public app
# identifier used above; the remaining values must never use a VITE_ prefix.
PRIVY_APP_ID=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Generate an independent random value of at least 32 characters.
OSHIAMI_SESSION_PEPPER=
